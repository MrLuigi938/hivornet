# systemd-Unit: setzt die Hivornet-Netzsperre bei jedem Start, BEVOR Docker die Container startet
# (sonst liefen sie nach einem Neustart kurz ohne Sperre). Die Regeln bleiben auch beim Anhalten
# der Unit bestehen; entfernen nur mit: sudo sh tools/firewall.sh remove
# Installation (Pfad anpassen, falls Hivornet woanders liegt):
#   sudo cp tools/hivornet-firewall.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hivornet-firewall
[Unit]
Description=Hivornet Netzsperre für Honeypot-Container
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=ALLOW_DOWNLOADS=0
# Drossel für Dauer-Brute-Force (siehe tools/firewall.sh; Werte aus der Hivornet-UI übernehmen):
Environment=BRUTE_LIMIT=0 BRUTE_RATE=6 BRUTE_BURST=20 BRUTE_BAN=15
#Environment="BRUTE_ALLOW=203.0.113.0/24"
ExecStart=/bin/sh /opt/hivornet/tools/firewall.sh apply

[Install]
WantedBy=multi-user.target
