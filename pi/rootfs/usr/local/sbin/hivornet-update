#!/bin/sh
# Hivornet-Updater für den Raspberry Pi (läuft als root, gestartet von hivornet-update.path).
#
# Der Hive legt nur die gewünschte Versionsnummer in /var/lib/hivornet/update-request ab.
# Dieses Skript
#   1. prüft, dass darin nichts als eine Versionsnummer steht,
#   2. lädt das Paket dieser Version von der festen GitHub-Adresse,
#   3. prüft die SHA-256-Prüfsumme aus derselben Veröffentlichung,
#   4. übernimmt die Systemdateien aus dem Paket (Ordner system/: systemd-Dienste,
#      Skripte unter /usr/local/sbin, Systembenutzer; nie Einstellungen unter /etc/hivornet),
#   5. tauscht hive und honeypot aus und startet die Dienste neu,
#   6. stellt die alte Version der Programme wieder her, wenn der Hive danach nicht läuft.
# Das Ergebnis steht in /var/lib/hivornet-update/status und erscheint in der UI unter System,
# die übernommenen Systemdateien in /var/lib/hivornet-update/system.
set -eu
# HIVORNET_TEST_ROOT nur für pi/test_update.sh (Pfade unterhalb eines Testordners)
ROOT=${HIVORNET_TEST_ROOT:-}
REQ=$ROOT/var/lib/hivornet/update-request
STATE=$ROOT/var/lib/hivornet-update
DEST=$ROOT/opt/hivornet
REPO=https://github.com/MrLuigi938/hivornet/releases/download

mkdir -p "$STATE"
status() { printf '%s %s\n' "$(date '+%d.%m.%Y %H:%M')" "$*" >"$STATE/status"; echo "$*"; }
fail() { status "Update fehlgeschlagen: $*"; rm -rf -- "$REQ"; exit 1; }

# Die Anforderung liegt in einem Ordner, in den der Hive schreiben darf: nichts
# daraus ausführen, nur die erste Zeile lesen und streng prüfen. Ein Ordner oder Link an
# dieser Stelle wird entfernt; sonst blockierte er jede spätere Anforderung.
if [ ! -f "$REQ" ] || [ -L "$REQ" ]; then
  rm -rf -- "$REQ"
  exit 0
fi
ver=$(head -c 40 "$REQ" | head -n 1 | tr -d '\r')
rm -f -- "$REQ"
printf '%s' "$ver" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+(-[a-z0-9.]+)?$' || fail "ungültige Versionsangabe"

# vercmp A B: -1, 0 oder 1 nach SemVer (Vorabversion < Release; Teile der Vorabversion
# numerisch, sonst als Text verglichen). Führendes "v" zählt nicht.
vercmp() {
  awk -v a="${1#v}" -v b="${2#v}" '
    function cmpid(x, y,   xn, yn) {
      xn = (x ~ /^[0-9]+$/); yn = (y ~ /^[0-9]+$/)
      if (xn && yn) return (x + 0 < y + 0) ? -1 : (x + 0 > y + 0)
      if (xn != yn) return xn ? -1 : 1
      return (x < y) ? -1 : (x > y)
    }
    BEGIN {
      ia = index(a, "-"); ib = index(b, "-")
      ca = ia ? substr(a, 1, ia - 1) : a; pa = ia ? substr(a, ia + 1) : ""
      cb = ib ? substr(b, 1, ib - 1) : b; pb = ib ? substr(b, ib + 1) : ""
      na = split(ca, x, "."); nb = split(cb, y, ".")
      for (i = 1; i <= 3; i++) if (x[i] + 0 != y[i] + 0) { print (x[i] + 0 < y[i] + 0) ? -1 : 1; exit }
      if (pa == pb) { print 0; exit }
      if (pa == "") { print 1; exit }
      if (pb == "") { print -1; exit }
      na = split(pa, x, "."); nb = split(pb, y, ".")
      for (i = 1; i <= na && i <= nb; i++) { c = cmpid(x[i], y[i]); if (c) { print c; exit } }
      print (na < nb) ? -1 : (na > nb)
    }'
}

# Keine ältere Version als die installierte (M7 des dritten Audits): Ein übernommener Hive
# könnte sonst eine alte Version samt alter Netzsperre und bekannter Lücken anfordern.
# Zurück geht es nur von Hand (Image neu aufspielen oder Paket selbst einspielen).
cur=$(head -n 1 "$DEST/VERSION" 2>/dev/null | tr -d '\r' || true)
if printf '%s' "$cur" | grep -Eq '^v?[0-9]+\.[0-9]+\.[0-9]+(-[a-z0-9.]+)?$' && [ "$(vercmp "$ver" "$cur")" = -1 ]; then
  fail "$ver ist älter als die installierte Version $cur; ältere Versionen werden nicht eingespielt"
fi

case "$(uname -m)" in
  aarch64) arch=arm64 ;;
  armv7l | armv6l) arch=armv7 ;;
  x86_64) arch=amd64 ;;
  *) fail "unbekannte Architektur $(uname -m)" ;;
esac
pkg="hivornet-$ver-linux-$arch.tar.gz"

get() { # get ADRESSE ZIEL
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --max-time 300 -o "$2" "$1"
  else
    wget -q -T 300 -O "$2" "$1"
  fi
}

tmp=$(mktemp -d "$STATE/dl.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
status "Lade $ver ..."
get "$REPO/$ver/$pkg" "$tmp/$pkg" || fail "Download von $pkg nicht möglich"
get "$REPO/$ver/SHA256SUMS" "$tmp/SHA256SUMS" || fail "Prüfsummen nicht abrufbar"
(cd "$tmp" && grep " $pkg\$" SHA256SUMS | sha256sum -c - >/dev/null 2>&1) || fail "Prüfsumme stimmt nicht"
mkdir "$tmp/x"
tar -xzf "$tmp/$pkg" -C "$tmp/x" --no-same-owner || fail "Paket nicht entpackbar"
for b in hive honeypot; do
  if [ ! -f "$tmp/x/$b" ] || [ -L "$tmp/x/$b" ]; then fail "$b fehlt im Paket"; fi
  chmod 755 "$tmp/x/$b"
done
HIVORNET_NO_SELFINSTALL=1 "$tmp/x/hive" version >/dev/null 2>&1 || fail "neues Programm startet nicht"

# Systemdateien aus dem Paket übernehmen (das Programm prüft, welche Dateien erlaubt sind)
if [ -d "$tmp/x/system" ] && [ ! -L "$tmp/x/system" ]; then
  status "Übernehme Systemdateien von $ver ..."
  "$tmp/x/hive" install-system "$tmp/x/system" >"$STATE/system" 2>&1 || fail "Systemdateien nicht übernommen (Einzelheiten in $STATE/system)"
fi

# Datenbank vorher sichern (wie update.sh im Docker-Betrieb); liegt dann unter /var/lib/hivornet/backups
runuser -u hivornet-hive -- env HIVE_DB=/var/lib/hivornet/hive.db "$DEST/hive" backup >/dev/null 2>&1 || true
systemctl stop hivornet-honeypot hivornet-hive || true
for b in hive honeypot; do
  cp -p "$DEST/$b" "$DEST/$b.alt" 2>/dev/null || true
  cp "$tmp/x/$b" "$DEST/$b.neu" && mv "$DEST/$b.neu" "$DEST/$b"
done
[ -f "$tmp/x/VERSION" ] && cp "$tmp/x/VERSION" "$DEST/VERSION"
systemctl start hivornet-hive hivornet-honeypot || true
sleep 15
if systemctl is-active --quiet hivornet-hive; then
  status "Aktualisiert auf $ver"
else
  for b in hive honeypot; do
    [ -f "$DEST/$b.alt" ] && mv "$DEST/$b.alt" "$DEST/$b"
  done
  systemctl restart hivornet-hive hivornet-honeypot || true
  status "Update auf $ver fehlgeschlagen, alte Version wiederhergestellt"
  exit 1
fi
