#!/bin/sh
# Wendet die Cowrie-Anmelderegel aus der Web-UI an (läuft als root, gestartet von
# hivornet-cowrie-config.path). Der Hive legt nur eine Zeile ab:
#   random MIN MAX   Anmeldung erst nach MIN bis MAX verschiedenen Versuchen je IP (1-20)
#   userdb           jede Kombination sofort (Cowries mitgelieferte Benutzerliste)
# Das Skript prüft die Zeile streng, trägt die Regel in cowrie.cfg ein und startet
# Cowrie neu. Stand für die UI: Zustand, Zeit, Text (wie bei der Cowrie-Installation).
set -eu
REQ=${HIVORNET_COWRIE_REQUEST:-/var/lib/hivornet/cowrie-request}
CFG=${HIVORNET_COWRIE_CFG:-/etc/hivornet/cowrie.cfg}
STATUS=${HIVORNET_STATUS_DIR:-/var/lib/hivornet-status}/cowrie-config

mkdir -p "$(dirname "$STATUS")"
status() { printf '%s\n%s\n%s\n' "$1" "$(date +%s)" "$2" >"$STATUS.neu" && mv "$STATUS.neu" "$STATUS"; }

# ---- Drossel für Dauer-Brute-Force (Einstellungen → Honeypot → Dauer-Brute-Force) ----
# Der Hive legt sie in brute-request ab (hive/bruteforce.go):
#   brute off | brute RATE BURST BAN    danach höchstens 200 Zeilen "allow NETZ"
# Jede Zeile wird streng geprüft (nur Ziffern, Punkte, Hex, Doppelpunkte, Schrägstrich), nach
# /etc/hivornet/brute.conf übernommen und mit hivornet-firewall angewendet; das prüft erneut und
# setzt die Netzsperre notfalls ohne Drossel. Stand für die UI: Statusdatei "brute".
BREQ=${HIVORNET_BRUTE_REQUEST:-/var/lib/hivornet/brute-request}
BCONF=${HIVORNET_BRUTE_CONF:-/etc/hivornet/brute.conf}
BSTATUS=${HIVORNET_STATUS_DIR:-/var/lib/hivornet-status}/brute
FIREWALL=${HIVORNET_FIREWALL:-/usr/local/sbin/hivornet-firewall}
bstatus() { printf '%s\n%s\n%s\n' "$1" "$(date +%s)" "$2" >"$BSTATUS.neu" && mv "$BSTATUS.neu" "$BSTATUS"; }

brute_request() {
  if [ ! -e "$BREQ" ] && [ ! -L "$BREQ" ]; then return 0; fi
  if [ ! -f "$BREQ" ] || [ -L "$BREQ" ]; then
    rm -rf -- "$BREQ"
    return 0
  fi
  in=$(head -c 16384 "$BREQ" | tr -d '\r')
  rm -f -- "$BREQ"
  out="" first=1 n=0 bad=""
  while IFS= read -r line; do
    if [ "$first" = 1 ]; then
      first=0
      if [ "$line" = "brute off" ]; then
        out="brute off"
        continue
      fi
      if ! printf '%s' "$line" | grep -Eq '^brute [0-9]{1,4} [0-9]{1,4} [0-9]{1,4}$'; then bad="erste Zeile"; break; fi
      r=$(echo "$line" | cut -d' ' -f2) b=$(echo "$line" | cut -d' ' -f3) m=$(echo "$line" | cut -d' ' -f4)
      if [ "$r" -lt 2 ] || [ "$r" -gt 120 ] || [ "$b" -lt 5 ] || [ "$b" -gt 1000 ] || [ "$m" -gt 1440 ]; then bad="Werte außerhalb der Grenzen"; break; fi
      out="brute $r $b $m"
      continue
    fi
    [ -z "$line" ] && continue
    n=$((n + 1))
    if [ "$n" -gt 200 ]; then bad="mehr als 200 Netze"; break; fi
    if printf '%s' "$line" | grep -Eq '^allow (([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])|[0-9a-fA-F]{0,4}(:[0-9a-fA-F]{0,4}){2,7}/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$'; then
      out="$out
$line"
    else
      bad="ungültiges Netz"
      break
    fi
  done <<EOI
$in
EOI
  if [ -n "$bad" ] || [ -z "$out" ]; then
    bstatus failed "Ungültige Anfrage aus der Web-UI (${bad:-leer}); Drossel unverändert"
    return 0
  fi
  printf '%s\n' "$out" >"$BCONF.neu"
  chmod 644 "$BCONF.neu"
  mv "$BCONF.neu" "$BCONF"
  "$FIREWALL" apply >/dev/null || bstatus failed "hivornet-firewall gescheitert; bisherige Regeln gelten weiter"
  echo "Drossel: $(head -n 1 "$BCONF")"
}
brute_request

# Die Anforderung liegt in einem Ordner, in den der Hive schreiben darf: nichts
# daraus ausführen, nur die erste Zeile lesen und streng prüfen. Ein Ordner oder Link an
# dieser Stelle wird entfernt; sonst blockierte er jede spätere Anforderung (rm -rf folgt
# keinen Links).
if [ ! -f "$REQ" ] || [ -L "$REQ" ]; then
  rm -rf -- "$REQ"
  exit 0
fi
line=$(head -c 64 "$REQ" | head -n 1 | tr -d '\r')
rm -f -- "$REQ"

if [ "$line" = "userdb" ]; then
  class=UserDB
  params=""
  text="jede Kombination sofort"
elif printf '%s' "$line" | grep -Eq '^random ([1-9]|1[0-9]|20) ([1-9]|1[0-9]|20)$'; then
  min=$(printf '%s' "$line" | cut -d' ' -f2)
  max=$(printf '%s' "$line" | cut -d' ' -f3)
  if [ "$min" -gt "$max" ]; then
    status failed "Ungültige Anfrage: Minimum größer als Maximum"
    exit 1
  fi
  class=AuthRandom
  params="$min, $max, 10"
  text="nach $min bis $max Versuchen je IP"
else
  status failed "Ungültige Anfrage aus der Web-UI"
  exit 1
fi

[ -f "$CFG" ] || { status failed "$CFG fehlt"; exit 1; }
tmp="$CFG.neu"
# alte Regel entfernen, neue direkt unter [honeypot] einfügen
awk -v cls="$class" -v par="$params" '
  /^[ \t]*auth_class/ { next }
  { print }
  /^[ \t]*\[honeypot\][ \t]*$/ && !done {
    print "auth_class = " cls
    if (par != "") print "auth_class_parameters = " par
    done = 1
  }
  END {
    if (!done) {
      print ""; print "[honeypot]"; print "auth_class = " cls
      if (par != "") print "auth_class_parameters = " par
    }
  }' "$CFG" >"$tmp"
chmod 644 "$tmp"
mv "$tmp" "$CFG"

if command -v systemctl >/dev/null 2>&1; then
  systemctl try-restart hivornet-cowrie.service || true
fi
status ok "Anmeldung $text (übernommen, Cowrie neu gestartet)"
echo "Cowrie: Anmeldung $text"
