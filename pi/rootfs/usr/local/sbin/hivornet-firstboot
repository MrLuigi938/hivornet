#!/bin/sh
# Hivornet auf dem Raspberry Pi: läuft einmal beim ersten Start.
# Erzeugt das gemeinsame Token von Honeypot und Hive. Das Admin-Passwort legt der
# Nutzer danach im Browser fest (Ersteinrichtung der Web-UI).
set -eu
# Ordner lesbar lassen: Der Honeypot liest dort honeypot.yml. Nur die Token-Datei ist geheim.
install -d -m 755 /etc/hivornet
umask 077
token=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
[ "${#token}" -eq 64 ] || { echo "Token konnte nicht erzeugt werden" >&2; exit 1; }
printf 'HIVORNET_TOKEN=%s\n' "$token" >/etc/hivornet/env.new
mv /etc/hivornet/env.new /etc/hivornet/env
echo "Hivornet: Token erzeugt. Web-UI: http://$(hostname).local:8088"
