#!/bin/sh
# Prüft vor jedem Start von Cowrie die SSH-Host-Schlüssel (ExecStartPre in
# hivornet-cowrie.service, läuft als Benutzer hivornet-cowrie).
#
# Cowrie erzeugt seine Host-Schlüssel beim ersten Start unter state_path. Fällt dabei
# der Strom aus, bleibt eine leere oder halbe Datei liegen. Cowrie erzeugt dann keinen
# neuen Schlüssel, sondern bricht beim Lesen ab ("BadKeyError: cannot guess the type
# of b''"), und Port 22 bleibt zu, während Telnet weiterläuft.
#
# Dieses Skript entfernt jedes Schlüsselpaar, von dem eine Hälfte leer ist oder nicht
# wie ein Schlüssel beginnt. Cowrie legt das Paar beim Start neu an. Angreifer sehen
# danach einen anderen Host-Schlüssel; das ist bei einem Honeypot ohne Bedeutung.
#
#   hivornet-cowrie-keycheck [ORDNER]     Standard: /var/lib/hivornet-cowrie/lib
set -u
DIR=${1:-/var/lib/hivornet-cowrie/lib}
[ -d "$DIR" ] || exit 0

# begins DATEI MUSTER: Datei nicht leer und die erste Zeile passt auf MUSTER
begins() {
  [ -f "$1" ] && [ -s "$1" ] && head -n 1 "$1" | head -c 200 | grep -Eq "$2"
}

for f in "$DIR"/ssh_host_*_key "$DIR"/ssh_host_*_key.pub; do
  [ -e "$f" ] || [ -L "$f" ] || continue # Muster ohne Treffer
  key=${f%.pub}
  [ -e "$key" ] || [ -e "$key.pub" ] || continue # Paar schon entfernt
  if begins "$key" '^-----BEGIN ' && begins "$key.pub" '^(ssh-|ecdsa-|sk-)'; then
    continue
  fi
  echo "Cowrie-Host-Schlüssel $key ist leer oder beschädigt; wird entfernt und beim Start neu erzeugt."
  rm -f "$key" "$key.pub"
done
exit 0
