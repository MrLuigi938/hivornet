#!/bin/sh
# Hivornet Netzsperre auf dem Raspberry Pi (Betrieb ohne Docker).
#
# Der Honeypot läuft als Benutzer hivornet-pot, Cowrie als hivornet-cowrie. Beiden
# wird jede NEUE ausgehende Verbindung verboten; erlaubt bleiben Antworten an Angreifer
# und (nur für den Honeypot) die Sensor-API des Hive auf 127.0.0.1:8089. Wird der Honeypot übernommen, kommt der
# Angreifer von dort weder ins Heimnetz noch ins Internet noch an die Web-UI.
#
#   hivornet-firewall apply | remove | status
#
# Verwaltungsanschluss: Ein USB-Netzwerkadapter (eth1 … eth9 oder enx…) darf ins
# Heimnetz, während der eingebaute Anschluss im Gastnetz steckt. Über ihn ist nur die
# Web-UI (Port 8088) erreichbar. Der Pi selbst baut dort keine Verbindung auf (nur
# Antworten, DHCP, IPv6-Nachbarsuche und mDNS für hivornet.local), und zwischen den
# Anschlüssen wird nichts weitergeleitet. Die Regeln hängen nur am Namen, gelten also
# auch für einen Adapter, der erst später eingesteckt wird.
#
# Die Web-UI zeigt unter System, ob die Sperre wirkt ("Internet aus dem Container")
# und ob der Verwaltungsanschluss geschützt ist (Statusdatei, siehe write_status).
set -eu
MGMT_IFS="eth1 eth2 eth3 eth4 eth5 eth6 eth7 eth8 eth9 enx*"
UI_PORT=8088
STATUS_DIR=${HIVORNET_STATUS_DIR:-/var/lib/hivornet-status}
POT=hivornet-pot
die() { printf 'FEHLER: %s\n' "$*" >&2; exit 1; }
id "$POT" >/dev/null 2>&1 || die "Benutzer $POT fehlt"
POT_UID=$(id -u "$POT")
# Cowrie ist optional (wird erst nach dem ersten Start installiert); ohne Benutzer keine Regel.
COW=hivornet-cowrie
COW_UID=$(id -u "$COW" 2>/dev/null || true)
# mDNS-Antworten (hivornet.local) kommen von avahi; ohne avahi keine Ausnahme
AVAHI_UID=$(id -u avahi 2>/dev/null || true)

# Statusdatei für die Web-UI: Zustand, Unix-Zeit, Text (wie bei hivornet-cowrie-install)
write_status() {
  mkdir -p "$STATUS_DIR" 2>/dev/null || return 0
  chmod 755 "$STATUS_DIR" 2>/dev/null || true
  printf '%s\n%s\n%s\n' "$1" "$(date +%s)" "$2" >"$STATUS_DIR/firewall.neu" 2>/dev/null || return 0
  chmod 644 "$STATUS_DIR/firewall.neu"
  mv "$STATUS_DIR/firewall.neu" "$STATUS_DIR/firewall"
}

# Verwaltungsanschluss mit iptables bzw. ip6tables ($1); "enx*" heißt dort "enx+"
ipt_mgmt() {
  ipt=$1
  $ipt -N HIVORNET-MGMT-IN
  $ipt -A HIVORNET-MGMT-IN -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  $ipt -A HIVORNET-MGMT-IN -p tcp --dport "$UI_PORT" -j ACCEPT
  $ipt -A HIVORNET-MGMT-IN -p udp --dport 5353 -j ACCEPT
  $ipt -N HIVORNET-MGMT-OUT
  $ipt -A HIVORNET-MGMT-OUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  if [ "$ipt" = ip6tables ]; then
    for t in router-advertisement neighbour-solicitation neighbour-advertisement echo-request; do
      $ipt -A HIVORNET-MGMT-IN -p ipv6-icmp --icmpv6-type "$t" -j ACCEPT
    done
    for t in router-solicitation neighbour-solicitation neighbour-advertisement 143; do
      $ipt -A HIVORNET-MGMT-OUT -p ipv6-icmp --icmpv6-type "$t" -j ACCEPT
    done
  else
    $ipt -A HIVORNET-MGMT-IN -p udp --sport 67 --dport 68 -j ACCEPT
    $ipt -A HIVORNET-MGMT-IN -p icmp --icmp-type echo-request -j ACCEPT
    $ipt -A HIVORNET-MGMT-OUT -p udp --sport 68 --dport 67 -j ACCEPT
  fi
  if [ -n "$AVAHI_UID" ]; then
    $ipt -A HIVORNET-MGMT-OUT -p udp --sport 5353 --dport 5353 -m owner --uid-owner "$AVAHI_UID" -j ACCEPT
  fi
  $ipt -A HIVORNET-MGMT-IN -j DROP
  $ipt -A HIVORNET-MGMT-OUT -j DROP
  for i in $MGMT_IFS; do
    i=$(printf '%s' "$i" | tr '*' '+')
    $ipt -I INPUT 1 -i "$i" -j HIVORNET-MGMT-IN
    $ipt -I OUTPUT 1 -o "$i" -j HIVORNET-MGMT-OUT
    $ipt -I FORWARD 1 -i "$i" -j DROP
    $ipt -I FORWARD 1 -o "$i" -j DROP
  done
}

ipt_mgmt_remove() {
  ipt=$1
  for i in $MGMT_IFS; do
    i=$(printf '%s' "$i" | tr '*' '+')
    while $ipt -D INPUT -i "$i" -j HIVORNET-MGMT-IN 2>/dev/null; do :; done
    while $ipt -D OUTPUT -o "$i" -j HIVORNET-MGMT-OUT 2>/dev/null; do :; done
    while $ipt -D FORWARD -i "$i" -j DROP 2>/dev/null; do :; done
    while $ipt -D FORWARD -o "$i" -j DROP 2>/dev/null; do :; done
  done
  for c in HIVORNET-MGMT-IN HIVORNET-MGMT-OUT; do
    $ipt -F "$c" 2>/dev/null || true
    $ipt -X "$c" 2>/dev/null || true
  done
}

remove() {
  if command -v nft >/dev/null 2>&1; then
    nft delete table inet hivornet 2>/dev/null || true
  fi
  remove_ipt
}

# remove_ipt: nur die iptables-Regeln (Reste eines früheren Laufs ohne nft)
remove_ipt() {
  if command -v iptables >/dev/null 2>&1; then
    while iptables -D OUTPUT -m owner --uid-owner "$POT" -j HIVORNET-POT 2>/dev/null; do :; done
    while iptables -D OUTPUT -m owner --uid-owner "$COW" -j HIVORNET-COW 2>/dev/null; do :; done
    iptables -F HIVORNET-COW 2>/dev/null || true
    iptables -X HIVORNET-COW 2>/dev/null || true
    iptables -F HIVORNET-POT 2>/dev/null || true
    iptables -X HIVORNET-POT 2>/dev/null || true
    ipt_mgmt_remove iptables
    if command -v ip6tables >/dev/null 2>&1; then ipt_mgmt_remove ip6tables; fi
  fi
}

apply() {
  if command -v nft >/dev/null 2>&1; then
    # Die Tabelle wird in EINEM Aufruf von nft ersetzt (N12 des dritten Audits): nft -f
    # übernimmt alles oder nichts. Vorher wurde sie erst gelöscht und dann neu gesetzt; dazwischen
    # und nach einem Fehler war der Honeypot ohne Sperre. Die erste Zeile legt die Tabelle an,
    # falls es sie noch nicht gibt, damit "delete" nicht scheitert.
    remove_ipt
    # Sprünge zum Verwaltungsanschluss: eine Regel je Name (Platzhalter wie enx* gehen
    # nicht in jeder nft-Version in einer Menge)
    jin="" jout="" jfwd=""
    for i in $MGMT_IFS; do
      jin="$jin    iifname \"$i\" jump mgmt_in
"
      jout="$jout    oifname \"$i\" jump mgmt_out
"
      jfwd="$jfwd    iifname \"$i\" drop
    oifname \"$i\" drop
"
    done
    mdns=""
    if [ -n "$AVAHI_UID" ]; then mdns="meta skuid $AVAHI_UID udp sport 5353 udp dport 5353 accept"; fi
    cow=""
    if [ -n "$COW_UID" ]; then
      cow="    meta skuid $COW_UID ct state established,related accept
    meta skuid $COW_UID drop
"
    fi
    nft -f - <<EOF || { write_status failed "nftables: Regeln nicht übernommen, bisherige Sperre gilt weiter"; die "nft -f gescheitert; bisherige Regeln unverändert"; }
table inet hivornet
delete table inet hivornet
table inet hivornet {
  chain mgmt_in {
    ct state established,related accept
    tcp dport $UI_PORT accept
    udp sport 67 udp dport 68 accept
    udp dport 5353 accept
    icmp type echo-request accept
    icmpv6 type { nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, echo-request } accept
    drop
  }
  chain mgmt_out {
    ct state established,related accept
    udp sport 68 udp dport 67 accept
    icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert, mld2-listener-report } accept
    $mdns
    drop
  }
  chain input {
    type filter hook input priority filter; policy accept;
$jin  }
  chain forward {
    type filter hook forward priority filter; policy accept;
$jfwd  }
  chain output {
    type filter hook output priority filter; policy accept;
$jout    meta skuid $POT_UID ct state established,related accept
    meta skuid $POT_UID oifname "lo" ip daddr 127.0.0.1 tcp dport 8089 accept
    meta skuid $POT_UID drop
$cow  }
}
EOF
    write_status ok "nftables: Honeypot gesperrt, Verwaltungsanschluss nur Port $UI_PORT"
    echo "Netzsperre aktiv (nftables)."
  elif command -v iptables >/dev/null 2>&1; then
    # Ohne nft (sehr alte Systeme): Regeln werden neu aufgebaut, kurz ohne Sperre
    remove
    iptables -N HIVORNET-POT
    iptables -A HIVORNET-POT -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
    iptables -A HIVORNET-POT -o lo -d 127.0.0.1 -p tcp --dport 8089 -j RETURN
    iptables -A HIVORNET-POT -j DROP
    iptables -I OUTPUT 1 -m owner --uid-owner "$POT" -j HIVORNET-POT
    if [ -n "$COW_UID" ]; then
      iptables -N HIVORNET-COW
      iptables -A HIVORNET-COW -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
      iptables -A HIVORNET-COW -j DROP
      iptables -I OUTPUT 1 -m owner --uid-owner "$COW" -j HIVORNET-COW
    fi
    ipt_mgmt iptables
    if command -v ip6tables >/dev/null 2>&1; then
      ipt_mgmt ip6tables
      write_status ok "iptables: Honeypot gesperrt, Verwaltungsanschluss nur Port $UI_PORT"
    else
      write_status failed "ip6tables fehlt: IPv6 am Verwaltungsanschluss ungeschützt"
    fi
    echo "Netzsperre aktiv (iptables)."
  else
    write_status failed "weder nft noch iptables vorhanden"
    die "weder nft noch iptables vorhanden; die Netzsperre fehlt"
  fi
}

case "${1:-apply}" in
  apply) apply ;;
  remove) remove; rm -f "$STATUS_DIR/firewall"; echo "Netzsperre entfernt." ;;
  status)
    if command -v nft >/dev/null 2>&1; then nft list table inet hivornet 2>/dev/null || echo "nicht aktiv"; fi
    ;;
  *) die "unbekannter Befehl: $1 (apply|remove|status)" ;;
esac
