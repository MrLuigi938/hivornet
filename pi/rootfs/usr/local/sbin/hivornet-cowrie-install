    ("root", "/usr/sbin/apache2 -k start", 213456, 9216, "Ss", 0.2),
    ("postfix", "qmgr -l -t unix -u", 41532, 6876, "S", 0.2),
    ("root", "/usr/bin/containerd", 1289412, 52480, "Ssl", 1.3),
    ("root", "/usr/sbin/cron -f", 8480, 2740, "Ss", 0.1),
    ("root", "/usr/lib/policykit-1/polkitd --no-debug", 235192, 7744, "Ssl", 0.2),
    ("root", "/usr/sbin/cups-browsed", 163484, 6408, "Ssl", 0.2),
)


def hivornet_persona(ip: str, now: float | None = None) -> dict:
    """Festes Gerät für diese IP in der laufenden Woche (siehe oben)."""
    now = time.time() if now is None else now
    week = int(now // HV_WEEK)
    d = hashlib.sha256(f"hivornet-persona|{week}|{ip}".encode()).digest()
    n = int.from_bytes(d[:8], "big")
    release, build = HV_KERNELS[(n >> 8) % len(HV_KERNELS)]
    boot = week * HV_WEEK - (2 + n % 120) * 86400 - (n >> 20) % 86400
    pick = [i for i in range(len(HV_DAEMONS)) if d[8 + i] % 3 == 0][:4] or [0]
    return {
        "hostname": f"{HV_ROLES[(n >> 40) % len(HV_ROLES)]}{1 + (n >> 48) % 9:02d}",
        "kernel": release,
        "build": build,
        "boot": float(boot),
        "daemons": [HV_DAEMONS[i] for i in pick],
        "pidbase": 520 + (n >> 16) % 400,
    }


def hivornet_processes(base: list | None, p: dict) -> list | None:
    """Prozessliste des Geräts: Startdatum = Boot, keine VM-Treiber, dazu die Dienste der Persona."""
    if not base:
        return base
    start = time.strftime("%b%d", time.gmtime(p["boot"]))
    out = []
    for e in base:
        cmd = str(e.get("COMMAND", ""))
        if "VBox" in cmd or "iprt" in cmd or "ttm_swap" in cmd:
            continue
        e = dict(e)
        e["START"] = start
        # Cowrie liefert VSZ und RSS in Byte und TIME als Zahl; ps zeigt KiB und m:ss
        e["VSZ"], e["RSS"] = int(e["VSZ"]) // 1024, int(e["RSS"]) // 1024
        secs = int(float(e["TIME"]) * 60)
        e["TIME"] = f"{secs // 60}:{secs % 60:02d}"
        out.append(e)
    pid = p["pidbase"]
    for user, cmd, vsz, rss, stat, mem in p["daemons"]:
        pid += 7 + len(cmd) % 23
        out.append({
            "USER": user, "PID": pid, "CPU": 0.0, "MEM": mem, "VSZ": vsz, "RSS": rss,
            "TTY": "?", "STAT": stat, "START": start, "TIME": "0:01", "COMMAND": cmd,
        })
    return sorted(out, key=lambda e: int(e["PID"]))


