        "class HoneyPotBaseProtocol(insults.TerminalProtocol, TimeoutMixin):",
        r'''# Hivornet: Persona. Jede Angreifer-IP sieht ein festes Gerät (Name, Kernel, Laufzeit, Dienste),
# bei jeder Verbindung dasselbe, ohne dass etwas gespeichert wird: Alles folgt aus IP und Woche.
# Nach 7 Tagen (Wochengrenze) wechselt es, wie ein neu aufgesetztes System. Test: pi/test_cowrie_persona.py.
HV_WEEK = 7 * 86400
HV_ROLES = (
    "nas-backup", "web-prod", "db-main", "mail-gw", "file-srv",
    "git-int", "app-node", "vpn-edge", "ci-runner", "media-box",
