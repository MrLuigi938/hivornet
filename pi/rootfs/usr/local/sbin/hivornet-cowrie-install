            "nonvoluntary_ctxt_switches:\t1\n"
        ).encode()

    def proc_uptime(self) -> bytes:'''
    s = once(s, old2, new2, "proc_uptime")

# ---- 2. Persona je Angreifer-IP ----
if "Hivornet: Persona" not in s:
    s = once(s, "import functools\n", "import functools\nimport hashlib\n", "import functools")
    s = once(
