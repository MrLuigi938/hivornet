#!/bin/sh
# Installiert Cowrie (SSH/Telnet-Honeypot mit gefälschter Shell) auf dem Raspberry Pi.
#
# Läuft als root über hivornet-cowrie-install.service: beim ersten Start und danach
# stündlich (Timer), bis die Installation einmal geklappt hat. Braucht Internet für
# Debian-Pakete, den Cowrie-Quelltext (Version und Prüfsumme fest) und die Python-Pakete.
#
# Ergebnis: /opt/hivornet/cowrie (Quelltext), /opt/hivornet/cowrie-env (Python-Umgebung),
# Merker /opt/hivornet/cowrie-env/.hivornet-ok. Danach starten hivornet-cowrie.service
# (Ports 22 und 23) und der tägliche Aufräum-Timer.
# Protokoll: journalctl -u hivornet-cowrie-install (in der Web-UI unter Protokolle).
# Den Stand (läuft, fertig, gescheitert bei Schritt X) schreibt es nach
# /var/lib/hivornet-status/cowrie-install; die Web-UI zeigt ihn unter System.
set -eu

VER=3.1.6
SHA256=a23bba17c06b82de18fcd11a440549fdc2e8f527e0e87ab85c2ad1b337dec3f8
URL="https://github.com/cowrie/cowrie/archive/refs/tags/v$VER.tar.gz"
DEST=/opt/hivornet/cowrie
VENV=/opt/hivornet/cowrie-env
MARK="$VENV/.hivornet-ok"

STATUS_DIR=${HIVORNET_STATUS_DIR:-/var/lib/hivornet-status}
mkdir -p "$STATUS_DIR"
chmod 755 "$STATUS_DIR"
# status ZUSTAND TEXT: Zeile 1 running|ok|failed, Zeile 2 Unix-Zeit, Zeile 3 Text
status() {
  printf '%s\n%s\n%s\n' "$1" "$(date +%s)" "$2" >"$STATUS_DIR/cowrie-install.neu"
  chmod 644 "$STATUS_DIR/cowrie-install.neu"
  mv "$STATUS_DIR/cowrie-install.neu" "$STATUS_DIR/cowrie-install"
}
STEP="Start"
step() { STEP=$1; echo "== $1"; status running "$1"; }
tmp=""
done_ok=0
finish() {
  rc=$?
  [ -n "$tmp" ] && rm -rf "$tmp"
  if [ "$done_ok" != 1 ]; then
    status failed "Schritt '$STEP' fehlgeschlagen (Exit-Code $rc). Neuer Versuch stündlich; Details unter Protokolle."
  fi
}
trap finish EXIT

# Anpassungen an Cowrie (Quelltext ist auf $VER festgelegt; jede Stelle wird genau ersetzt, passt
# eine nicht mehr, bricht das Skript ab, statt Cowrie halb angepasst zu starten):
#  1. /proc/self/stat und /proc/self/status liefern echte Werte. Bots, die nach dem Login prüfen,
#     ob sie in einem Honeypot sind, lesen beide Dateien und vergleichen die Prozessnummer mit $$
#     (Prüfreihe, siehe Konzept KI-Honeypot); in Cowrie waren sie leer, die Prüfung fiel durch.
#  2. Persona: jede Angreifer-IP sieht ein festes Gerät (Name, Kernel, Laufzeit, Dienste in ps),
#     bei jeder Verbindung dasselbe, nach 7 Tagen ein neues. Ohne das hat Cowrie ein Gerät für alle,
#     dessen Laufzeit sich bei jedem Neustart ändert und dessen ps eine VirtualBox-VM zeigt.
# Läuft auch bei schon fertiger Installation (siehe unten). Tests: pi/test_cowrie_proc_self.py,
# pi/test_cowrie_persona.py.
patches_missing() {
  grep -q "Hivornet: /proc/self" "$DEST/src/cowrie/shell/protocol.py" 2>/dev/null &&
    grep -q "Hivornet: Persona" "$DEST/src/cowrie/shell/protocol.py" 2>/dev/null && return 1
  return 0
}
apply_patches() {
  [ -f "$DEST/src/cowrie/shell/protocol.py" ] || { echo "$DEST/src/cowrie/shell/protocol.py fehlt" >&2; return 1; }
  if ! patches_missing; then return 0; fi
  "$VENV/bin/python3" - "$DEST" <<'PYEOF'
import re
import sys

root = sys.argv[1]


def load(rel):
    return open(root + "/" + rel, encoding="utf-8", newline="").read()


def save(rel, s):
    open(root + "/" + rel, "w", encoding="utf-8", newline="").write(s)


def once(s, old, new, what):
    if s.count(old) != 1:
        sys.exit("Cowrie-Anpassung: Stelle nicht gefunden: " + what)
    return s.replace(old, new, 1)


proto = "src/cowrie/shell/protocol.py"
uname = "src/cowrie/commands/uname.py"
s = load(proto)

# ---- 1. /proc/self/* (Prüfreihe der Bots) ----
if "Hivornet: /proc/self" not in s:
    old1 = '''        self.fs.generated_files["/proc/uptime"] = self.proc_uptime
'''
    new1 = old1 + r'''        # Hivornet: /proc/self/* wie auf einem echten System (die Prüfreihen der Bots lesen sie)
        self.fs.generated_files["/proc/self/stat"] = self.proc_self_stat
        self.fs.generated_files["/proc/self/status"] = self.proc_self_status
        self.fs.generated_files["/proc/self/comm"] = lambda: b"bash\n"
        self.fs.generated_files["/proc/self/cmdline"] = lambda: b"-bash\x00"
'''
    s = once(s, old1, new1, "generated_files")
    old2 = "    def proc_uptime(self) -> bytes:"
    new2 = r'''    def _proc_self_pids(self) -> tuple[int, int]:
        """(pid, ppid) der Shell, die gerade läuft: dasselbe wie $$ und $PPID."""
        shell = self.cmdstack[-1] if self.cmdstack else None
        pid = int(getattr(shell, "pid", 0) or self.last_pid)
        return pid, max(1, pid - 1 - pid % 3)

    def proc_self_stat(self) -> bytes:
        """/proc/self/stat einer schlafenden bash (52 Felder, Feld 1 ist $$)."""
        pid, ppid = self._proc_self_pids()
        start = int(self.uptime() * 100) + 12
        return (
            f"{pid} (bash) S {ppid} {pid} {pid} 34816 {pid} 4194304 1840 21433 0 3 "
            f"2 1 14 11 20 0 1 0 {start} 7512064 1411 18446744073709551615 "
            "94205342257152 94205343139085 140726051536000 0 0 0 65536 3670020 "
            "1266777851 1 0 0 17 1 0 0 0 0 0 94205343409296 94205343461216 "
            "94205374423040 140726051544018 140726051544028 140726051544028 "
            "140726051545070 0\n"
        ).encode()

    def proc_self_status(self) -> bytes:
        """/proc/self/status einer bash ohne eigenen PID-Namensraum (NSpid = Pid)."""
        pid, ppid = self._proc_self_pids()
        uid = int(getattr(self.user, "uid", 0) or 0)
        return (
            "Name:\tbash\nUmask:\t0022\nState:\tS (sleeping)\n"
            f"Tgid:\t{pid}\nNgid:\t0\nPid:\t{pid}\nPPid:\t{ppid}\nTracerPid:\t0\n"
            f"Uid:\t{uid}\t{uid}\t{uid}\t{uid}\nGid:\t{uid}\t{uid}\t{uid}\t{uid}\n"
            f"FDSize:\t256\nGroups:\t{uid} \n"
            f"NStgid:\t{pid}\nNSpid:\t{pid}\nNSpgid:\t{pid}\nNSsid:\t{pid}\n"
            "VmPeak:\t    7336 kB\nVmSize:\t    7336 kB\nVmLck:\t       0 kB\n"
            "VmPin:\t       0 kB\nVmHWM:\t    5644 kB\nVmRSS:\t    5644 kB\n"
            "Threads:\t1\nSigQ:\t0/15393\nSigPnd:\t0000000000000000\n"
            "Cpus_allowed_list:\t0-3\nvoluntary_ctxt_switches:\t3\n"
            "nonvoluntary_ctxt_switches:\t1\n"
        ).encode()

    def proc_uptime(self) -> bytes:'''
    s = once(s, old2, new2, "proc_uptime")

# ---- 2. Persona je Angreifer-IP ----
if "Hivornet: Persona" not in s:
    s = once(s, "import functools\n", "import functools\nimport hashlib\n", "import functools")
    s = once(
        s,
        "class HoneyPotBaseProtocol(insults.TerminalProtocol, TimeoutMixin):",
        r'''# Hivornet: Persona. Jede Angreifer-IP sieht ein festes Gerät (Name, Kernel, Laufzeit, Dienste),
# bei jeder Verbindung dasselbe, ohne dass etwas gespeichert wird: Alles folgt aus IP und Woche.
# Nach 7 Tagen (Wochengrenze) wechselt es, wie ein neu aufgesetztes System. Test: pi/test_cowrie_persona.py.
HV_WEEK = 7 * 86400
HV_ROLES = (
    "nas-backup", "web-prod", "db-main", "mail-gw", "file-srv",
    "git-int", "app-node", "vpn-edge", "ci-runner", "media-box",
)
HV_KERNELS = (
    ("6.1.0-18-amd64", "#1 SMP PREEMPT_DYNAMIC Debian 6.1.76-1 (2024-02-01)"),
    ("6.1.0-20-amd64", "#1 SMP PREEMPT_DYNAMIC Debian 6.1.85-1 (2024-04-11)"),
    ("6.1.0-21-amd64", "#1 SMP PREEMPT_DYNAMIC Debian 6.1.90-1 (2024-05-03)"),
    ("6.1.0-22-amd64", "#1 SMP PREEMPT_DYNAMIC Debian 6.1.94-1 (2024-06-21)"),
    ("6.1.0-23-amd64", "#1 SMP PREEMPT_DYNAMIC Debian 6.1.99-1 (2024-07-15)"),
    ("6.1.0-25-amd64", "#1 SMP PREEMPT_DYNAMIC Debian 6.1.106-3 (2024-08-26)"),
    ("6.1.0-26-amd64", "#1 SMP PREEMPT_DYNAMIC Debian 6.1.112-1 (2024-09-30)"),
)
# (Benutzer, Befehlszeile, VSZ, RSS, STAT, Anteil %MEM)
HV_DAEMONS = (
    ("root", "/usr/sbin/nginx -g daemon on; master_process on;", 55320, 5340, "Ss", 0.1),
    ("www-data", "nginx: worker process", 56240, 4180, "S", 0.1),
    ("mysql", "/usr/sbin/mariadbd", 1331256, 98240, "Ssl", 2.4),
    ("root", "/usr/sbin/smbd --foreground --no-process-group", 87864, 11292, "Ss", 0.3),
    ("root", "/usr/sbin/apache2 -k start", 213456, 9216, "Ss", 0.2),
    ("postfix", "qmgr -l -t unix -u", 41532, 6876, "S", 0.2),
    ("root", "/usr/bin/containerd", 1289412, 52480, "Ssl", 1.3),
    ("root", "/usr/sbin/cron -f", 8480, 2740, "Ss", 0.1),
    ("root", "/usr/lib/policykit-1/polkitd --no-debug", 235192, 7744, "Ssl", 0.2),
    ("root", "/usr/sbin/cups-browsed", 163484, 6408, "Ssl", 0.2),
)


def hivornet_persona(ip: str, now: float | None = None) -> dict:
    """Festes Gerät für diese IP in der laufenden Woche (siehe oben)."""
    now = time.time() if now is None else now
    week = int(now // HV_WEEK)
    d = hashlib.sha256(f"hivornet-persona|{week}|{ip}".encode()).digest()
    n = int.from_bytes(d[:8], "big")
    release, build = HV_KERNELS[(n >> 8) % len(HV_KERNELS)]
    boot = week * HV_WEEK - (2 + n % 120) * 86400 - (n >> 20) % 86400
    pick = [i for i in range(len(HV_DAEMONS)) if d[8 + i] % 3 == 0][:4] or [0]
    return {
        "hostname": f"{HV_ROLES[(n >> 40) % len(HV_ROLES)]}{1 + (n >> 48) % 9:02d}",
        "kernel": release,
        "build": build,
        "boot": float(boot),
        "daemons": [HV_DAEMONS[i] for i in pick],
        "pidbase": 520 + (n >> 16) % 400,
    }


def hivornet_processes(base: list | None, p: dict) -> list | None:
    """Prozessliste des Geräts: Startdatum = Boot, keine VM-Treiber, dazu die Dienste der Persona."""
    if not base:
        return base
    start = time.strftime("%b%d", time.gmtime(p["boot"]))
    out = []
    for e in base:
        cmd = str(e.get("COMMAND", ""))
        if "VBox" in cmd or "iprt" in cmd or "ttm_swap" in cmd:
            continue
        e = dict(e)
        e["START"] = start
        # Cowrie liefert VSZ und RSS in Byte und TIME als Zahl; ps zeigt KiB und m:ss
        e["VSZ"], e["RSS"] = int(e["VSZ"]) // 1024, int(e["RSS"]) // 1024
        secs = int(float(e["TIME"]) * 60)
        e["TIME"] = f"{secs // 60}:{secs % 60:02d}"
        out.append(e)
    pid = p["pidbase"]
    for user, cmd, vsz, rss, stat, mem in p["daemons"]:
        pid += 7 + len(cmd) % 23
        out.append({
            "USER": user, "PID": pid, "CPU": 0.0, "MEM": mem, "VSZ": vsz, "RSS": rss,
            "TTY": "?", "STAT": stat, "START": start, "TIME": "0:01", "COMMAND": cmd,
        })
    return sorted(out, key=lambda e: int(e["PID"]))


class HoneyPotBaseProtocol(insults.TerminalProtocol, TimeoutMixin):''',
        "class HoneyPotBaseProtocol",
    )
    s = once(
        s,
        '''        self.fs.generated_files["/proc/self/cmdline"] = lambda: b"-bash\\x00"
''',
        '''        self.fs.generated_files["/proc/self/cmdline"] = lambda: b"-bash\\x00"
        # Hivornet: Persona (fester Gerätezustand je Angreifer-IP)
        self.hv_persona = hivornet_persona(self.realClientIP)
        self.hostname = self.hv_persona["hostname"]
        self.hv_sshd_pid = self.next_pid()
        self.user.server.process = hivornet_processes(self.user.server.process, self.hv_persona)
        self.fs.generated_files["/etc/hostname"] = lambda: (self.hostname + "\\n").encode()
        self.fs.generated_files["/proc/version"] = lambda: (
            f"Linux version {self.hv_persona['kernel']} (debian-kernel@lists.debian.org) "
            f"(gcc-12 (Debian 12.2.0-14) 12.2.0, GNU ld (GNU Binutils for Debian) 2.40) {self.hv_persona['build']}\\n"
        ).encode()
''',
        "cmdline",
    )
    s = once(
        s,
        "        return float(self.getProtoTransport().factory.starttime) - boot_offset()",
        '''        persona = getattr(self, "hv_persona", None)
        if persona:  # Hivornet: Persona, fester Startzeitpunkt je Angreifer und Woche
            return persona["boot"]
        return float(self.getProtoTransport().factory.starttime) - boot_offset()''',
        "boot_time",
    )
    save(proto, s)

    u = load(uname)
    u = once(
        u,
        '''def kernel_version() -> str:
    return CowrieConfig.get("shell", "kernel_version", fallback="3.2.0-4-amd64")


def kernel_build_string() -> str:
    return CowrieConfig.get(''',
        '''def kernel_version(protocol=None) -> str:
    persona = getattr(protocol, "hv_persona", None)  # Hivornet: Persona
    if persona:
        return persona["kernel"]
    return CowrieConfig.get("shell", "kernel_version", fallback="3.2.0-4-amd64")


def kernel_build_string(protocol=None) -> str:
    persona = getattr(protocol, "hv_persona", None)  # Hivornet: Persona
    if persona:
        return persona["build"]
    return CowrieConfig.get(''',
        "uname-Funktionen",
    )
    for name in ("kernel_version", "kernel_build_string"):
        calls = len(re.findall(r"(?<!def )\b" + name + r"\(\)", u))
        if calls != 2:
            sys.exit(f"Cowrie-Anpassung: {name}() kommt {calls}-mal vor, erwartet 2")
        u = re.sub(r"(?<!def )\b" + name + r"\(\)", name + "(self.protocol)", u)
    save(uname, u)

    # ps: eigene Prozesse der Sitzung (sshd, bash, ps) mit Startzeit der Sitzung und stabilen PIDs
    base = "src/cowrie/commands/base.py"
    b = load(base)
    b = once(
        b,
        "            process = random.randint(4000, 8000)\n",
        '            process = getattr(self.protocol, "hv_sshd_pid", None) or random.randint(4000, 8000)\n'
        '            hv_login = time.strftime("%H:%M", time.localtime(getattr(self.protocol, "logintime", time.time())))\n',
        "ps: PID",
    )
    b = once(b, '"%s".ljust(8 - len("Jul22")) % "Jul22"', '"%s".ljust(8 - len(hv_login)) % hv_login', "ps: Jul22")
    if b.count('"%s".ljust(8 - len("06:30")) % "06:30"') != 2:
        sys.exit("Cowrie-Anpassung: ps: 06:30 nicht zweimal gefunden")
    b = b.replace('"%s".ljust(8 - len("06:30")) % "06:30"', '"%s".ljust(8 - len(hv_login)) % hv_login')
    b = once(
        b,
        "            process = process + 2\n",
        "            process = self.protocol.next_pid()  # Hivornet: jeder ps-Aufruf ist ein neuer Prozess\n",
        "ps: process + 2",
    )
    save(base, b)
else:
    save(proto, s)
PYEOF
  for f in shell/protocol.py commands/uname.py commands/base.py; do
    "$VENV/bin/python3" -m compileall -q -f "$DEST/src/cowrie/$f" || true
  done
}

if [ -f "$MARK" ]; then
  # Schon installiert (ältere Version des Skripts): fehlende Anpassung nachtragen
  if patches_missing; then
    step "Cowrie anpassen"
    apply_patches
    command -v systemctl >/dev/null 2>&1 && { systemctl try-restart hivornet-cowrie.service || true; }
  fi
  status ok "Cowrie $VER installiert"
  done_ok=1
  exit 0
fi
echo "Installiere Cowrie $VER ..."

export DEBIAN_FRONTEND=noninteractive
step "Paketlisten laden (apt-get update)"
apt-get update -q
step "Werkzeuge installieren (apt-get install)"
# Build-Werkzeuge nur für den Fall, dass für ein Python-Paket kein fertiges Rad existiert
apt-get install -y -q --no-install-recommends python3-venv python3-dev build-essential libffi-dev libssl-dev curl ca-certificates

step "Cowrie $VER herunterladen"
tmp=$(mktemp -d)
curl -fsSL --max-time 300 -o "$tmp/cowrie.tar.gz" "$URL"
echo "$SHA256  $tmp/cowrie.tar.gz" | sha256sum -c - >/dev/null || { echo "Prüfsumme des Cowrie-Quelltexts stimmt nicht" >&2; exit 1; }

step "Cowrie entpacken"
rm -rf "$DEST" "$VENV"
mkdir -p "$DEST"
tar -xzf "$tmp/cowrie.tar.gz" -C "$DEST" --strip-components=1 --no-same-owner
step "Python-Pakete installieren"
python3 -m venv "$VENV"
"$VENV/bin/pip" install -q --upgrade pip
"$VENV/bin/pip" install -q -r "$DEST/requirements.txt"
# Cowrie selbst als Paket eintragen: Erst dabei entsteht src/cowrie/_version.py. Ohne sie
# bricht "import cowrie" ab, und twistd kennt den Befehl "cowrie" nicht. Der Quelltext von
# GitHub hat kein .git, darum die Versionsnummer für setuptools_scm vorgeben.
SETUPTOOLS_SCM_PRETEND_VERSION_FOR_COWRIE="$VER" "$VENV/bin/pip" install -q --no-deps -e "$DEST"

step "Cowrie anpassen"
apply_patches

# Einstellungen von Hivornet (Pfade, Ports 22/23, Download-Grenze). Cowrie liest ./cowrie.cfg
# im Arbeitsverzeichnis des Dienstes.
step "Cowrie einrichten"
ln -sf /etc/hivornet/cowrie.cfg "$DEST/cowrie.cfg"
# Zur Laufzeit ist der Quelltext nur lesbar: Bytecode und den Plugin-Zwischenspeicher
# von Twisted jetzt einmal erzeugen, damit Cowrie beim Start nichts schreiben muss.
"$VENV/bin/python3" -m compileall -q "$DEST/src" || true
PYTHONPATH="$DEST/src" "$VENV/bin/python3" -c "from twisted.plugin import IPlugin, getPlugins; list(getPlugins(IPlugin))" || true
chown -R root:root "$DEST" "$VENV"
chmod -R go-w "$DEST" "$VENV"

# Prüfen, dass twistd das Cowrie-Plugin findet (wie hivornet-cowrie.service, gleiche Umgebung).
# Scheitert das, bleibt der Merker aus und der Timer versucht es später erneut.
step "Cowrie prüfen"
PYTHONPATH="$DEST/src" "$VENV/bin/python3" -c "import cowrie" || { echo "Cowrie lässt sich nicht importieren" >&2; exit 1; }
(cd "$DEST" && PYTHONPATH="$DEST/src" "$VENV/bin/twistd" --help) | grep -q "^ *cowrie " || { echo "twistd findet das Cowrie-Plugin nicht" >&2; exit 1; }

touch "$MARK"
step "Cowrie starten"
systemctl daemon-reload
systemctl enable --now hivornet-cowrie.service hivornet-cowrie-clean.timer
status ok "Cowrie $VER installiert"
done_ok=1
echo "Cowrie $VER installiert und gestartet (SSH 22, Telnet 23)."
