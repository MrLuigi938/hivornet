#!/bin/sh
# Installiert Cowrie (SSH/Telnet-Honeypot mit gefälschter Shell) auf dem Raspberry Pi.
#
# Läuft als root über hivornet-cowrie-install.service: beim ersten Start und danach
# stündlich (Timer), bis die Installation einmal geklappt hat. Braucht Internet für
# Debian-Pakete, den Cowrie-Quelltext (Version und Prüfsumme fest) und die Python-Pakete.
#
# Ergebnis: /opt/hivornet/cowrie (Quelltext), /opt/hivornet/cowrie-env (Python-Umgebung),
# Merker /opt/hivornet/cowrie-env/.hivornet-ok. Danach starten hivornet-cowrie.service
# (Ports 22 und 23) und der tägliche Aufräum-Timer.
# Protokoll: journalctl -u hivornet-cowrie-install (in der Web-UI unter Protokolle).
# Den Stand (läuft, fertig, gescheitert bei Schritt X) schreibt es nach
# /var/lib/hivornet-status/cowrie-install; die Web-UI zeigt ihn unter System.
set -eu

VER=3.1.6
SHA256=a23bba17c06b82de18fcd11a440549fdc2e8f527e0e87ab85c2ad1b337dec3f8
URL="https://github.com/cowrie/cowrie/archive/refs/tags/v$VER.tar.gz"
DEST=/opt/hivornet/cowrie
VENV=/opt/hivornet/cowrie-env
MARK="$VENV/.hivornet-ok"

STATUS_DIR=${HIVORNET_STATUS_DIR:-/var/lib/hivornet-status}
mkdir -p "$STATUS_DIR"
chmod 755 "$STATUS_DIR"
# status ZUSTAND TEXT: Zeile 1 running|ok|failed, Zeile 2 Unix-Zeit, Zeile 3 Text
status() {
  printf '%s\n%s\n%s\n' "$1" "$(date +%s)" "$2" >"$STATUS_DIR/cowrie-install.neu"
  chmod 644 "$STATUS_DIR/cowrie-install.neu"
  mv "$STATUS_DIR/cowrie-install.neu" "$STATUS_DIR/cowrie-install"
}
STEP="Start"
step() { STEP=$1; echo "== $1"; status running "$1"; }
tmp=""
done_ok=0
finish() {
  rc=$?
  [ -n "$tmp" ] && rm -rf "$tmp"
  if [ "$done_ok" != 1 ]; then
    status failed "Schritt '$STEP' fehlgeschlagen (Exit-Code $rc). Neuer Versuch stündlich; Details unter Protokolle."
  fi
}
trap finish EXIT

# Anpassung an Cowrie: /proc/self/stat und /proc/self/status liefern echte Werte. Bots, die nach
# dem Login prüfen, ob sie in einem Honeypot sind, lesen beide Dateien und vergleichen die
# Prozessnummer mit $$ (Prüfreihe, siehe Konzept KI-Honeypot); in Cowrie sind sie leer, und die
# Prüfung fiel dort durch. Der Quelltext ist auf $VER festgelegt, darum genügt ein genauer Ersatz
# der Stellen; passt eine nicht mehr, bricht das Skript ab, statt Cowrie halb angepasst zu starten.
# Läuft auch bei schon fertiger Installation (siehe unten). Test: pi/test_cowrie_proc_self.py.
PATCH_MARK="Hivornet: /proc/self"
apply_patches() {
  f="$DEST/src/cowrie/shell/protocol.py"
  [ -f "$f" ] || { echo "$f fehlt" >&2; return 1; }
  if grep -q "$PATCH_MARK" "$f"; then return 0; fi
  "$VENV/bin/python3" - "$f" <<'PYEOF'
import sys

p = sys.argv[1]
s = open(p, encoding="utf-8", newline="").read()

old1 = '''        self.fs.generated_files["/proc/uptime"] = self.proc_uptime
'''
new1 = old1 + r'''        # Hivornet: /proc/self/* wie auf einem echten System (die Prüfreihen der Bots lesen sie)
        self.fs.generated_files["/proc/self/stat"] = self.proc_self_stat
        self.fs.generated_files["/proc/self/status"] = self.proc_self_status
        self.fs.generated_files["/proc/self/comm"] = lambda: b"bash\n"
        self.fs.generated_files["/proc/self/cmdline"] = lambda: b"-bash\x00"
'''
if s.count(old1) != 1:
    sys.exit("Cowrie-Anpassung: Stelle für generated_files nicht gefunden")
s = s.replace(old1, new1, 1)

old2 = "    def proc_uptime(self) -> bytes:"
new2 = r'''    def _proc_self_pids(self) -> tuple[int, int]:
        """(pid, ppid) der Shell, die gerade läuft: dasselbe wie $$ und $PPID."""
        shell = self.cmdstack[-1] if self.cmdstack else None
        pid = int(getattr(shell, "pid", 0) or self.last_pid)
        return pid, max(1, pid - 1 - pid % 3)

    def proc_self_stat(self) -> bytes:
        """/proc/self/stat einer schlafenden bash (52 Felder, Feld 1 ist $$)."""
        pid, ppid = self._proc_self_pids()
        start = int(self.uptime() * 100) + 12
        return (
            f"{pid} (bash) S {ppid} {pid} {pid} 34816 {pid} 4194304 1840 21433 0 3 "
            f"2 1 14 11 20 0 1 0 {start} 7512064 1411 18446744073709551615 "
            "94205342257152 94205343139085 140726051536000 0 0 0 65536 3670020 "
            "1266777851 1 0 0 17 1 0 0 0 0 0 94205343409296 94205343461216 "
            "94205374423040 140726051544018 140726051544028 140726051544028 "
            "140726051545070 0\n"
        ).encode()

    def proc_self_status(self) -> bytes:
        """/proc/self/status einer bash ohne eigenen PID-Namensraum (NSpid = Pid)."""
        pid, ppid = self._proc_self_pids()
        uid = int(getattr(self.user, "uid", 0) or 0)
        return (
            "Name:\tbash\nUmask:\t0022\nState:\tS (sleeping)\n"
            f"Tgid:\t{pid}\nNgid:\t0\nPid:\t{pid}\nPPid:\t{ppid}\nTracerPid:\t0\n"
            f"Uid:\t{uid}\t{uid}\t{uid}\t{uid}\nGid:\t{uid}\t{uid}\t{uid}\t{uid}\n"
            f"FDSize:\t256\nGroups:\t{uid} \n"
            f"NStgid:\t{pid}\nNSpid:\t{pid}\nNSpgid:\t{pid}\nNSsid:\t{pid}\n"
            "VmPeak:\t    7336 kB\nVmSize:\t    7336 kB\nVmLck:\t       0 kB\n"
            "VmPin:\t       0 kB\nVmHWM:\t    5644 kB\nVmRSS:\t    5644 kB\n"
            "Threads:\t1\nSigQ:\t0/15393\nSigPnd:\t0000000000000000\n"
            "Cpus_allowed_list:\t0-3\nvoluntary_ctxt_switches:\t3\n"
            "nonvoluntary_ctxt_switches:\t1\n"
        ).encode()

    def proc_uptime(self) -> bytes:'''
if s.count(old2) != 1:
    sys.exit("Cowrie-Anpassung: Stelle für proc_uptime nicht gefunden")
s = s.replace(old2, new2, 1)
open(p, "w", encoding="utf-8", newline="").write(s)
PYEOF
  "$VENV/bin/python3" -m compileall -q -f "$f" || true
}

if [ -f "$MARK" ]; then
  # Schon installiert (ältere Version des Skripts): fehlende Anpassung nachtragen
  if ! grep -q "$PATCH_MARK" "$DEST/src/cowrie/shell/protocol.py" 2>/dev/null; then
    step "Cowrie anpassen"
    apply_patches
    command -v systemctl >/dev/null 2>&1 && { systemctl try-restart hivornet-cowrie.service || true; }
  fi
  status ok "Cowrie $VER installiert"
  done_ok=1
  exit 0
fi
echo "Installiere Cowrie $VER ..."

export DEBIAN_FRONTEND=noninteractive
step "Paketlisten laden (apt-get update)"
apt-get update -q
step "Werkzeuge installieren (apt-get install)"
# Build-Werkzeuge nur für den Fall, dass für ein Python-Paket kein fertiges Rad existiert
apt-get install -y -q --no-install-recommends python3-venv python3-dev build-essential libffi-dev libssl-dev curl ca-certificates

step "Cowrie $VER herunterladen"
tmp=$(mktemp -d)
curl -fsSL --max-time 300 -o "$tmp/cowrie.tar.gz" "$URL"
echo "$SHA256  $tmp/cowrie.tar.gz" | sha256sum -c - >/dev/null || { echo "Prüfsumme des Cowrie-Quelltexts stimmt nicht" >&2; exit 1; }

step "Cowrie entpacken"
rm -rf "$DEST" "$VENV"
mkdir -p "$DEST"
tar -xzf "$tmp/cowrie.tar.gz" -C "$DEST" --strip-components=1 --no-same-owner
step "Python-Pakete installieren"
python3 -m venv "$VENV"
"$VENV/bin/pip" install -q --upgrade pip
"$VENV/bin/pip" install -q -r "$DEST/requirements.txt"
# Cowrie selbst als Paket eintragen: Erst dabei entsteht src/cowrie/_version.py. Ohne sie
# bricht "import cowrie" ab, und twistd kennt den Befehl "cowrie" nicht. Der Quelltext von
# GitHub hat kein .git, darum die Versionsnummer für setuptools_scm vorgeben.
SETUPTOOLS_SCM_PRETEND_VERSION_FOR_COWRIE="$VER" "$VENV/bin/pip" install -q --no-deps -e "$DEST"

step "Cowrie anpassen"
apply_patches

# Einstellungen von Hivornet (Pfade, Ports 22/23, Download-Grenze). Cowrie liest ./cowrie.cfg
# im Arbeitsverzeichnis des Dienstes.
step "Cowrie einrichten"
ln -sf /etc/hivornet/cowrie.cfg "$DEST/cowrie.cfg"
# Zur Laufzeit ist der Quelltext nur lesbar: Bytecode und den Plugin-Zwischenspeicher
# von Twisted jetzt einmal erzeugen, damit Cowrie beim Start nichts schreiben muss.
"$VENV/bin/python3" -m compileall -q "$DEST/src" || true
PYTHONPATH="$DEST/src" "$VENV/bin/python3" -c "from twisted.plugin import IPlugin, getPlugins; list(getPlugins(IPlugin))" || true
chown -R root:root "$DEST" "$VENV"
chmod -R go-w "$DEST" "$VENV"

# Prüfen, dass twistd das Cowrie-Plugin findet (wie hivornet-cowrie.service, gleiche Umgebung).
# Scheitert das, bleibt der Merker aus und der Timer versucht es später erneut.
step "Cowrie prüfen"
PYTHONPATH="$DEST/src" "$VENV/bin/python3" -c "import cowrie" || { echo "Cowrie lässt sich nicht importieren" >&2; exit 1; }
(cd "$DEST" && PYTHONPATH="$DEST/src" "$VENV/bin/twistd" --help) | grep -q "^ *cowrie " || { echo "twistd findet das Cowrie-Plugin nicht" >&2; exit 1; }

touch "$MARK"
step "Cowrie starten"
systemctl daemon-reload
systemctl enable --now hivornet-cowrie.service hivornet-cowrie-clean.timer
status ok "Cowrie $VER installiert"
done_ok=1
echo "Cowrie $VER installiert und gestartet (SSH 22, Telnet 23)."
