        if persona:  # Hivornet: Persona, fester Startzeitpunkt je Angreifer und Woche
            return persona["boot"]
        return float(self.getProtoTransport().factory.starttime) - boot_offset()''',
        "boot_time",
    )
    save(proto, s)

    u = load(uname)
    u = once(
        u,
        '''def kernel_version() -> str:
    return CowrieConfig.get("shell", "kernel_version", fallback="3.2.0-4-amd64")


def kernel_build_string() -> str:
    return CowrieConfig.get(''',
        '''def kernel_version(protocol=None) -> str:
    persona = getattr(protocol, "hv_persona", None)  # Hivornet: Persona
    if persona:
        return persona["kernel"]
    return CowrieConfig.get("shell", "kernel_version", fallback="3.2.0-4-amd64")


def kernel_build_string(protocol=None) -> str:
    persona = getattr(protocol, "hv_persona", None)  # Hivornet: Persona
    if persona:
        return persona["build"]
    return CowrieConfig.get(''',
        "uname-Funktionen",
    )
    for name in ("kernel_version", "kernel_build_string"):
        calls = len(re.findall(r"(?<!def )\b" + name + r"\(\)", u))
        if calls != 2:
            sys.exit(f"Cowrie-Anpassung: {name}() kommt {calls}-mal vor, erwartet 2")
        u = re.sub(r"(?<!def )\b" + name + r"\(\)", name + "(self.protocol)", u)
    save(uname, u)

    # ps: eigene Prozesse der Sitzung (sshd, bash, ps) mit Startzeit der Sitzung und stabilen PIDs
    base = "src/cowrie/commands/base.py"
    b = load(base)
    b = once(
        b,
        "            process = random.randint(4000, 8000)\n",
        '            process = getattr(self.protocol, "hv_sshd_pid", None) or random.randint(4000, 8000)\n'
        '            hv_login = time.strftime("%H:%M", time.localtime(getattr(self.protocol, "logintime", time.time())))\n',
        "ps: PID",
    )
    b = once(b, '"%s".ljust(8 - len("Jul22")) % "Jul22"', '"%s".ljust(8 - len(hv_login)) % hv_login', "ps: Jul22")
    if b.count('"%s".ljust(8 - len("06:30")) % "06:30"') != 2:
        sys.exit("Cowrie-Anpassung: ps: 06:30 nicht zweimal gefunden")
    b = b.replace('"%s".ljust(8 - len("06:30")) % "06:30"', '"%s".ljust(8 - len(hv_login)) % hv_login')
    b = once(
        b,
        "            process = process + 2\n",
        "            process = self.protocol.next_pid()  # Hivornet: jeder ps-Aufruf ist ein neuer Prozess\n",
        "ps: process + 2",
    )
    save(base, b)
else:
    save(proto, s)

# ---- 3. Modell für Unbekanntes (über den Hive); die Datei shell/hivornet_ai.py legt das Skript vorher ab ----
s = load(proto)
if "Hivornet: Modell" not in s:
    if "Hivornet: Persona" not in s:
        sys.exit("Cowrie-Anpassung: Persona fehlt")
    s = once(
        s,
        "from cowrie.shell import command, fs, honeypot\n",
        "from cowrie.shell import command, fs, honeypot\nfrom cowrie.shell.hivornet_ai import HiveAI  # Hivornet: Modell\n",
        "import honeypot",
    )
    s = once(
        s,
        "        self.hv_sshd_pid = self.next_pid()\n",
        "        self.hv_sshd_pid = self.next_pid()\n        self.hv_ai = HiveAI(self)  # Hivornet: Modell\n",
        "hv_sshd_pid",
    )
    save(proto, s)
    hp = "src/cowrie/shell/honeypot.py"
    h = load(hp)
    h = once(
        h,
        '''        if not cmdclass:
            self.protocol.events.dispatch(
                "cowrie.command.failed",''',
        '''        hv_ai = getattr(self.protocol, "hv_ai", None)  # Hivornet: Modell
        if hv_ai is not None:
            from cowrie.shell.hivornet_ai import model_command

            hv_ai.note(cmd, args)
            if not cmdclass and not exec_seen:
                cmdclass = model_command(self.protocol, cmd, args)
        if not cmdclass:
            self.protocol.events.dispatch(
                "cowrie.command.failed",''',
        "honeypot: not cmdclass",
    )
    save(hp, h)

# ---- 4. Fremdprotokoll: HTTP-Zeilen sind keine Anmeldung ----
# Web-Scanner schicken "GET / HTTP/1.1" an Telnet; Cowrie liest die Anfragezeile als Benutzer,
# die erste Kopfzeile als Passwort. AuthRandom nahm nach einigen Zeilen eine Kopfzeile
# ("User-Agent: …" / "Accept: */*") als Login an, die übrigen Kopfzeilen kamen als Befehle.
au = "src/cowrie/core/auth.py"
a = load(au)
if "Hivornet: Fremdprotokoll" not in a:
    a = once(
        a,
        """        userpass: str = login + ":" + passwd
""",
        r"""        userpass: str = login + ":" + passwd
        if re.match(  # Hivornet: Fremdprotokoll
            r"(GET|POST|HEAD|PUT|DELETE|OPTIONS|CONNECT|PATCH|TRACE|PRI) \S+ HTTP/\d|[A-Za-z][A-Za-z0-9-]{0,40}:(\s|$)",
            login.strip(),
        ):
            return False
""",
        "AuthRandom userpass",
    )
    save(au, a)
PYEOF
  for f in shell/protocol.py shell/honeypot.py shell/hivornet_ai.py commands/uname.py commands/base.py core/auth.py; do
    "$VENV/bin/python3" -m compileall -q -f "$DEST/src/cowrie/$f" || true
  done
}

if [ -f "$MARK" ]; then
  # Schon installiert (ältere Version des Skripts): Token und fehlende Anpassungen nachtragen
  ensure_token
  if patches_missing; then
    step "Cowrie anpassen"
    apply_patches
    command -v systemctl >/dev/null 2>&1 && { systemctl try-restart hivornet-cowrie.service || true; }
  fi
  status ok "Cowrie $VER installiert"
  done_ok=1
  exit 0
fi
echo "Installiere Cowrie $VER ..."

export DEBIAN_FRONTEND=noninteractive
step "Paketlisten laden (apt-get update)"
apt-get update -q
step "Werkzeuge installieren (apt-get install)"
# Build-Werkzeuge nur für den Fall, dass für ein Python-Paket kein fertiges Rad existiert
apt-get install -y -q --no-install-recommends python3-venv python3-dev build-essential libffi-dev libssl-dev curl ca-certificates

step "Cowrie $VER herunterladen"
tmp=$(mktemp -d)
curl -fsSL --max-time 300 -o "$tmp/cowrie.tar.gz" "$URL"
echo "$SHA256  $tmp/cowrie.tar.gz" | sha256sum -c - >/dev/null || { echo "Prüfsumme des Cowrie-Quelltexts stimmt nicht" >&2; exit 1; }

step "Cowrie entpacken"
rm -rf "$DEST" "$VENV"
mkdir -p "$DEST"
tar -xzf "$tmp/cowrie.tar.gz" -C "$DEST" --strip-components=1 --no-same-owner
step "Python-Pakete installieren"
python3 -m venv "$VENV"
"$VENV/bin/pip" install -q --upgrade pip
"$VENV/bin/pip" install -q -r "$DEST/requirements.txt"
# Cowrie selbst als Paket eintragen: Erst dabei entsteht src/cowrie/_version.py. Ohne sie
# bricht "import cowrie" ab, und twistd kennt den Befehl "cowrie" nicht. Der Quelltext von
# GitHub hat kein .git, darum die Versionsnummer für setuptools_scm vorgeben.
SETUPTOOLS_SCM_PRETEND_VERSION_FOR_COWRIE="$VER" "$VENV/bin/pip" install -q --no-deps -e "$DEST"

step "Cowrie anpassen"
apply_patches

# Einstellungen von Hivornet (Pfade, Ports 22/23, Download-Grenze). Cowrie liest ./cowrie.cfg
# im Arbeitsverzeichnis des Dienstes.
step "Cowrie einrichten"
ln -sf /etc/hivornet/cowrie.cfg "$DEST/cowrie.cfg"
# Zur Laufzeit ist der Quelltext nur lesbar: Bytecode und den Plugin-Zwischenspeicher
# von Twisted jetzt einmal erzeugen, damit Cowrie beim Start nichts schreiben muss.
"$VENV/bin/python3" -m compileall -q "$DEST/src" || true
PYTHONPATH="$DEST/src" "$VENV/bin/python3" -c "from twisted.plugin import IPlugin, getPlugins; list(getPlugins(IPlugin))" || true
chown -R root:root "$DEST" "$VENV"
chmod -R go-w "$DEST" "$VENV"

# Prüfen, dass twistd das Cowrie-Plugin findet (wie hivornet-cowrie.service, gleiche Umgebung).
# Scheitert das, bleibt der Merker aus und der Timer versucht es später erneut.
step "Cowrie prüfen"
PYTHONPATH="$DEST/src" "$VENV/bin/python3" -c "import cowrie" || { echo "Cowrie lässt sich nicht importieren" >&2; exit 1; }
(cd "$DEST" && PYTHONPATH="$DEST/src" "$VENV/bin/twistd" --help) | grep -q "^ *cowrie " || { echo "twistd findet das Cowrie-Plugin nicht" >&2; exit 1; }

touch "$MARK"
step "Cowrie starten"
systemctl daemon-reload
systemctl enable --now hivornet-cowrie.service hivornet-cowrie-clean.timer
status ok "Cowrie $VER installiert"
done_ok=1
echo "Cowrie $VER installiert und gestartet (SSH 22, Telnet 23)."
