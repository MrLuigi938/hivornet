# Netzsperre auf dem Raspberry Pi: Der Benutzer des Honeypots darf keine neuen
# Verbindungen aufbauen (nur Antworten an Angreifer und den Weg zum Hive).
[Unit]
Description=HoneyLite Netzsperre
After=systemd-sysusers.service network-pre.target
Before=honeylite-honeypot.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/honeylite-firewall apply
ExecStop=/usr/local/sbin/honeylite-firewall remove

[Install]
WantedBy=multi-user.target
