# Cowrie auf dem Raspberry Pi: SSH (22) und Telnet (23) mit gefälschter Shell.
# Läuft als eigener Benutzer ohne Rechte; für die Ports unter 1024 genügt
# CAP_NET_BIND_SERVICE. Ausgehende Verbindungen sperrt hivornet-firewall.service.
# Der Hive liest /var/lib/hivornet-cowrie/log/cowrie.json mit.
[Unit]
Description=Hivornet Cowrie (SSH/Telnet-Honeypot)
After=network-online.target hivornet-firewall.service
Wants=network-online.target
# Ohne Netzsperre startet Cowrie nicht.
Requires=hivornet-firewall.service
ConditionPathExists=/opt/hivornet/cowrie-env/.hivornet-ok

[Service]
User=hivornet-cowrie
WorkingDirectory=/opt/hivornet/cowrie
Environment=PYTHONPATH=/opt/hivornet/cowrie/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Leere oder beschädigte SSH-Host-Schlüssel (z. B. nach Stromausfall beim ersten Start)
# entfernen, sonst bricht Cowrie beim Lesen ab und Port 22 bleibt zu.
ExecStartPre=/usr/local/sbin/hivornet-cowrie-keycheck /var/lib/hivornet-cowrie/lib
ExecStart=/opt/hivornet/cowrie-env/bin/twistd -n --umask=0022 --pidfile= --logger cowrie.python.logfile.stdoutLogger cowrie
Restart=always
RestartSec=10
# Cowrie legt die Unterordner von state_path nicht selbst an: ohne lib/tty fehlen die
# Mitschnitte ("Failed to open TTY log"), ohne lib/downloads die nachgeladenen Dateien.
StateDirectory=hivornet-cowrie hivornet-cowrie/log hivornet-cowrie/lib hivornet-cowrie/lib/tty hivornet-cowrie/lib/downloads
StateDirectoryMode=0755
MemoryMax=256M
TasksMax=256
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
# Daten und Status des Hives bleiben unsichtbar, auch nach einer Codeausführung (Audit 4)
InaccessiblePaths=-/var/lib/hivornet -/etc/hivornet/env
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# Angeglichen an hivornet-honeypot.service (N13 des dritten Audits). Bewusst noch nicht:
# MemoryDenyWriteExecute (Python-Erweiterungen über cffi brauchen ausführbaren Speicher),
# ProcSubset=pid und der Wegfall von AF_UNIX; beides erst nach einem Test auf dem Pi.
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
