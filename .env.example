# Hivornet Einstellungen. install.sh legt daraus die Datei .env an und füllt
# Token, Passwort und HIVE_BIND automatisch. Nach Änderungen: docker compose up -d
# Werte ohne Anführungszeichen und ohne Leerzeichen eintragen.

# --- Zugang ---
# Gemeinsames Geheimnis zwischen Honeypot und Hive (lang und zufällig).
HIVORNET_TOKEN=
# Admin-Konto der Web-UI. Das Passwort gilt nur beim ersten Start (10 bis 72 Zeichen);
# install.sh entfernt es danach wieder aus dieser Datei. Später in der UI ändern.
# Bleibt es leer, fragt die Web-UI beim ersten Aufruf nach einem Passwort (Ersteinrichtung).
HIVE_ADMIN_USER=admin
HIVE_ADMIN_PASSWORD=
# Passwort vergessen: HIVE_ADMIN_PASSWORD neu setzen, HIVE_RESET_ADMIN=1, Hive neu starten, danach wieder 0.
HIVE_RESET_ADMIN=0

# --- Allgemein ---
# Name dieses Sensors in der UI
SENSOR_NAME=nas
# "cowrie" = mit SSH/Telnet-Honeypot und Aufräum-Dienst (empfohlen). Leer = nur Go-Honeypot.
COMPOSE_PROFILES=cowrie
# Version (Image-Tags)
HIVORNET_VERSION=0.4.0-beta.3

# --- Datenhaltung ---
# Rohdaten und Angreifer-IPs so viele Tage aufbewahren (Statistiken ohne IPs bleiben)
HIVE_RETENTION_DAYS=30
# Höchstgröße der Datenbank in MB; darüber werden die ältesten Ereignisse gelöscht
HIVE_MAX_DB_MB=2048
# So viel Speicher (MB) soll auf dem Datenträger mindestens frei bleiben
HIVE_MIN_FREE_MB=1024
# So oft schreibt der Hive in die Datenbank (Millisekunden). Auf einem Raspberry Pi mit
# SD-Karte 5000 eintragen: weniger Schreibvorgänge, der Live-Feed kommt dann 5 s später.
HIVE_FLUSH_MS=300
# Cowrie-Logs, TTY-Mitschnitte und Downloads nach so vielen Tagen löschen
COWRIE_KEEP_DAYS=14
# Hostname, den Cowrie Angreifern zeigt
COWRIE_HOSTNAME=nas-backup01

# --- Web-UI ---
# Adresse, an der die UI lauscht: die LAN-IP der NAS (install.sh trägt sie ein).
# NIE im Router freigeben. 127.0.0.1 = nur von der NAS selbst (z. B. per SSH-Tunnel).
HIVE_BIND=127.0.0.1
HIVE_PORT=8088
# Zusätzliche erlaubte Hostnamen für die UI (Schutz gegen DNS-Rebinding), kommagetrennt.
# IP-Adressen, localhost, *.local, *.lan, *.fritz.box und Namen ohne Punkt sind immer erlaubt.
HIVE_ALLOWED_HOSTS=
# 1, wenn die UI hinter einem Reverse-Proxy mit HTTPS läuft (Cookie nur über HTTPS)
HIVE_COOKIE_SECURE=0
# "off" schaltet die Prüfung auf neue Versionen bei GitHub ab (zweimal täglich, ohne Datenübertragung)
HIVE_UPDATE_CHECK=on
# Token für Prometheus-Kennzahlen unter /metrics (leer = abgeschaltet)
HIVE_METRICS_TOKEN=

# --- Öffentliche Honeypot-Ports auf der NAS ---
# Diese NAS-Ports leitest du im Router weiter, z. B. extern 22 -> NAS 10022.
# Hohe Ports, damit nichts mit Diensten der NAS (SSH, Weboberfläche) kollidiert.
PORT_SSH=10022
PORT_TELNET=10023
PORT_FTP=10021
PORT_HTTP=10080
PORT_HTTPS=10443
PORT_HTTP_ALT=18080
PORT_DOCKER=12375
PORT_SSH_TARPIT=12222
PORT_MYSQL=13306
PORT_REDIS=16379
# VNC (im Container Port 5900; der Name stammt aus Version 0.2)
PORT_RAW=15900
PORT_SMTP=10025
# Telnet des Go-Honeypots (extern 2323); Port 23 gehört Cowrie
PORT_TELNET_ALT=12323
PORT_RDP=13389
# UDP-Dienste (zeichnen nur auf, antworten nie): extern 5060/udp, 161/udp, 53/udp
PORT_SIP=15060
PORT_SNMP=10161
PORT_DNS=10053
